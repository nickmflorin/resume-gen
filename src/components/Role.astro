---
import { NodeType, TitleLayout, type ResolvedNode, type ResolvedRole } from '../data/types';
import { logo } from '../lib/assets';
import Pills from './Pills.astro';

/*
 * One role. The prose arrives already normalized and resolved for the resume channel (see
 * `rolesByKey`), so this component never decides what is published — only how it looks.
 */
interface Props {
  role: ResolvedRole;
}

const { role } = Astro.props;
const { summary, content, skills } = role.content;

/**
 * A node's title and content as one string of HTML. Both are HTML — titles carry entities such as
 * `Bundle Size &amp; First Load Performance` — so both are emitted with `set:html` rather than as
 * text nodes.
 *
 * An INLINE title runs into the content after a dash, which is how every list item reads. A STACKED
 * title sits above its content; at the top level that is the `<h4>` below, and inside a list it is
 * a line break.
 */
function titled(node: Pick<ResolvedNode, 'title' | 'content' | 'titleLayout'>): string {
  const body = node.content ?? '';
  if (node.title === null) {
    return body;
  }
  const title = `<strong>${node.title}</strong>`;
  if (body === '') {
    return title;
  }
  return node.titleLayout === TitleLayout.Inline ? `${title} - ${body}` : `${title}<br />${body}`;
}

/*
 * Precomputed per section to keep the markup below flat. `list` is the element a section's
 * children render into, null when it has none; `prose` is the section's own paragraph, empty when
 * it is nothing but a titled list.
 *
 * The two list branches below are written out rather than collapsed into an Astro dynamic tag
 * (`<List>`) on purpose: a dynamic tag renders as a component, and components drop the whitespace
 * around their slot content, which reformats the emitted HTML.
 */
const sections = content.map(node => ({
  node,
  list:
    node.children.length === 0
      ? null
      : node.type === NodeType.BulletedList
        ? ('ul' as const)
        : ('ol' as const),
  prose: node.titleLayout === TitleLayout.Inline ? titled(node) : (node.content ?? ''),
}));
---

<div class='role'>
  <div class='role-logo'>
    <img src={logo(role.logo)} alt={role.company} />
  </div>
  <div class='role-body'>
    <p class='role-title'>{role.title}</p>
    <div class='role-company'>{role.company}</div>
    <div class='role-meta'>
      <span>{role.dates}</span>
      <span>{role.location}</span>
    </div>
    {summary.map(node => <p class='role-summary' set:html={titled(node)} />)}
    {
      sections.map(({ node, list, prose }) => (
        <div class='sub'>
          {node.title !== null && node.titleLayout === TitleLayout.Stacked && (
            <h4 set:html={node.title} />
          )}
          {prose !== '' && <p set:html={prose} />}
          {list === 'ul' ? (
            <ul>
              {node.children.map(child => (
                <li set:html={titled(child)} />
              ))}
            </ul>
          ) : list === 'ol' ? (
            <ol>
              {node.children.map(child => (
                <li set:html={titled(child)} />
              ))}
            </ol>
          ) : null}
        </div>
      ))
    }
    <Pills pills={skills} where='main' />
  </div>
</div>

---
/*
 * A wrapped row of technology chips. `where` selects the sidebar variant (`s-pill`, used for
 * skill groups) or the main-column variant (`m-pill`, used under a role).
 */
interface Props {
  /** Readonly because a role's chips arrive as the `skills` of a resolved content owner. */
  pills: readonly string[];
  where?: 'sidebar' | 'main';
}

const { pills, where = 'main' } = Astro.props;
const prefix = where === 'sidebar' ? 's' : 'm';
---

<div class={`${prefix}-pills`}>
  {pills.map(pill => <span class={`${prefix}-pill`}>{pill}</span>)}
</div>
